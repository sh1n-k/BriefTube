ENV=dev
POLLING_INTERVAL_MINUTES=15
MAX_RETRY_COUNT=3
LLM_TIMEOUT_SECONDS=120
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
THUMBNAIL_DIR=./thumbnails
DOWNLOAD_DIR=./downloads
DB_PATH=./data.db
RSS_TIMEOUT_SECONDS=20
RSS_CHANNEL_DEACTIVATE_AFTER_FAILS=3
RSS_CONSECUTIVE_ERROR_ABORT_THRESHOLD=5
HTTP_TIMEOUT_SECONDS=30
DOWNLOAD_MAX_CONCURRENT=2
DOWNLOAD_TIMEOUT_SECONDS=1800
TRANSCRIPT_FETCH_BATCH_SIZE=1
TRANSCRIPT_REQUEST_INTERVAL_SECONDS=15
TRANSCRIPT_IDLE_SLEEP_SECONDS=5
TRANSCRIPT_RETRY_BASE_DELAY_SECONDS=120
TRANSCRIPT_RETRY_MAX_DELAY_SECONDS=3600
TRANSCRIPT_RETRY_MAX_ATTEMPTS=8
TRANSCRIPT_FETCH_TIMEOUT_SECONDS=45
TRANSCRIPT_JITTER_RATIO=0.30
TRANSCRIPT_ADAPTIVE_ENABLED=true
TRANSCRIPT_ADAPTIVE_MAX_FACTOR=8.0
TRANSCRIPT_HARD_COOLDOWN_BASE_SECONDS=300
TRANSCRIPT_HARD_COOLDOWN_MAX_SECONDS=3600
TRANSCRIPT_RECOVERY_SUCCESS_WINDOW=5
TRANSCRIPT_GENERAL_ERROR_SLOWDOWN_MULTIPLIER=1.25
TRANSCRIPT_CHANNEL_MIN_INTERVAL_SECONDS=180
TRANSCRIPT_CHANNEL_PICK_LOOKAHEAD=20
TRANSCRIPT_CHANNEL_HARD_COOLDOWN_SECONDS=900
TRANSCRIPT_BREAKER_HALF_OPEN_PROBE_COUNT=1
TRANSCRIPT_WORKER_LEASE_ENABLED=true
TRANSCRIPT_WORKER_LEASE_TTL_SECONDS=45
LOG_LEVEL=AUTO
LOG_TO_FILE=false
LOG_DIR=./logs
LOG_FILE_NAME=brieftube.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10
LOG_NOISE_WINDOW_SECONDS=60
LOG_NOISE_SUPPRESS_THRESHOLD=1
LOG_DEPENDENCY_LEVEL=WARNING
